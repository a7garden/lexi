    },
    "질의가 사전에 없으면 저장된 표현 중 철자가 가장 가까운 것으로 찾아줘요. 끄면 입력한 원본 텍스트를 그대로 사용해요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "When a query isn't in the dictionary, finds the saved expression with the closest spelling. Turn it off to use your original text as-is." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "検索語が辞書にない場合、つづりが最も近い保存済み表現で探します。オフにすると入力した元のテキストをそのまま使います。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查询词不在词典中时，会找拼写最接近的已存表述。关闭后按输入的原文使用。" } }
      }
    },
    "조회" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Lookup" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "検索" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查询" } }
      }
    },
    "iCloud 동기화" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "iCloud Sync" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "iCloud同期" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iCloud 同步" } }
      }
    },
    "개념·별칭·개정본·출처를 iCloud에 동기화해요. 같은 Apple ID로 쓰는 기기에서 같은 사전을 쓸 수 있어요. 조회 통계와 설정은 동기화하지 않아요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Syncs concepts, aliases, revisions, and sources to iCloud. Devices signed in with the same Apple ID share the same dictionary. Lookup statistics and settings don't sync." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "概念・別名・改訂版・出典をiCloudに同期します。同じApple IDでサインインしたデバイスで同じ辞書を使えます。検索統計と設定は同期しません。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将概念、别名、修订版本和出处同步到 iCloud。登录同一 Apple ID 的设备可共用同一词典。查询统计和设置不参与同步。" } }
      }
    },
    "동기화" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sync" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "同期" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "同步" } }
      }
    },
    "선택한 텍스트 조회" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Look Up Selected Text" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択テキストを検索" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查询所选文本" } }
      }
    },
    "다른 앱에서 텍스트를 선택한 뒤 누르세요. 자주 쓰는 단축키와 겹치면 여기서 바꿀 수 있어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Select text in another app, then press it. If it conflicts with a shortcut you already use, change it here." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "他のアプリでテキストを選択してから押してください。よく使うショートカットと重なる場合はここで変更できます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "先在其他应用中选择文本再按下。如与常用快捷键冲突，可在此更改。" } }
      }
    },
    "단축키" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Shortcuts" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ショートカット" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "快捷键" } }
      }
    },
    "손쉬운 사용 권한" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility Permission" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アクセシビリティ権限" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "辅助功能权限" } }
      }
    },
    "허용됨" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Granted" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "許可済み" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已允许" } }
      }
    },
    "설정 필요" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Needs Setup" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定が必要" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要设置" } }
      }
    },
    "단축키로 다른 앱의 선택 영역을 읽을 때 필요해요. 우클릭 서비스는 이 권한 없이 사용할 수 있어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Needed to read another app's selection with the shortcut. The right-click service works without it." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ショートカットで他のアプリの選択範囲を読むときに必要です。右クリックサービスはこの権限なしで使えます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用快捷键读取其他应用的选区时需要。右键服务无需此权限。" } }
      }
    },
    "접근 권한" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Permissions" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アクセス権限" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "访问权限" } }
      }
    },
    "손쉬운 사용 설정 열기…" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Accessibility Settings…" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アクセシビリティ設定を開く…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开辅助功能设置…" } }
      }
    },
    "설정에서 Lexi를 켜면 잠시 뒤 자동으로 반영돼요. 여전히 '설정 필요'로 보이면 Lexi를 종료한 뒤 다시 실행해 주세요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "After you enable Lexi in Settings, this updates automatically within a moment. If it still says \"Needs Setup\", quit and relaunch Lexi." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "設定でLexiをオンにすると、まもなく自動で反映されます。「設定が必要」のままの場合は、Lexiを終了して再度起動してください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在设置中开启 Lexi 后稍候会自动更新。如果仍显示“需要设置”，请退出并重新运行 Lexi。" } }
      }
    },
    "Lexi에게 물어보기" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ask Lexi" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Lexiに聞く" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "询问 Lexi" } }
      }
    },
    "텍스트 선택 → 우클릭 → 서비스 → Lexi에게 물어보기에서 사용할 수 있어요. macOS 서비스는 호출 앱이 메뉴 위치를 정하므로 Lexi가 최상위에 고정할 수 없어요. 더 빠른 호출은 위 전역 단축키를 사용하거나, 권한 없이 쓰려면 서비스 설정에서 별도 단축키를 지정하세요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Available via select text → right-click → Services → Ask Lexi. macOS services let the calling app decide the menu position, so Lexi can't pin it to the top. For a faster call use the global shortcut above; to use it without the permission, assign a dedicated shortcut in Services settings." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "テキスト選択 → 右クリック → サービス → Lexiに聞くから使えます。macOSのサービスは呼び出し側アプリがメニュー位置を決めるため、Lexiが最上位に固定することはできません。速く呼ぶには上のグローバルショートカットを、権限なしで使うにはサービス設定で専用のショートカットを割り当ててください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用法：选择文本 → 右键 → 服务 → 询问 Lexi。macOS 服务的菜单位置由调用应用决定，Lexi 无法将其固定在顶部。更快的方式是使用上方的全局快捷键；若想免权限使用，可在服务设置中为其单独指定快捷键。" } }
      }
    },
    "우클릭 서비스" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Right-click Service" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "右クリックサービス" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "右键服务" } }
      }
    },
    "서비스 단축키 설정 열기…" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Services Shortcut Settings…" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "サービスのショートカット設定を開く…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开服务快捷键设置…" } }
      }
    },
    "목록 새로고침" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Refresh List" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "リストを再読み込み" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "刷新列表" } }
      }
    },
    "등록 정보를 새로고쳤어요. 사용하던 앱에서 메뉴를 다시 열어 주세요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Registration refreshed. Reopen the menu in the app you were using." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "登録情報を更新しました。使っていたアプリでメニューを開き直してください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "注册信息已刷新，请在之前使用的应用中重新打开菜单。" } }
      }
    },
    "이 Mac에서 실행" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Runs on This Mac" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このMacで実行" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在此 Mac 上运行" } }
      }
    },
    "Apple Silicon의 MLX 모델로 설명을 만들어요. 저장된 개념은 모델을 실행하지 않고 바로 보여 줍니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Writes explanations with an MLX model on Apple Silicon. Saved concepts appear instantly without running the model." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Apple SiliconのMLXモデルで説明を作成します。保存済みの概念はモデルを実行せずすぐ表示されます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用 Apple Silicon 上的 MLX 模型生成解释。已保存的概念无需运行模型即可立即显示。" } }
      }
    },
    "사용할 모델" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Model" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "使用するモデル" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要使用的模型" } }
      }
    },
    "Hugging Face 모델 ID" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hugging Face Model ID" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Hugging FaceモデルID" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Hugging Face 模型 ID" } }
      }
    },
    "소유자/모델 이름" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "owner/model-name" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "オーナー/モデル名" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所有者/模型名" } }
      }
    },
    "소유자/모델 이름 형식으로 입력해 주세요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter it in owner/model-name format." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "オーナー/モデル名の形式で入力してください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请按 所有者/模型名 格式输入。" } }
      }
    },
    "MLX 모델 찾아보기" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Browse MLX Models" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "MLXモデルを探す" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "浏览 MLX 模型" } }
      }
    },
    "적용" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Apply" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "適用" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "应用" } }
      }
    },
    "저장했어요. 다음 조회부터 적용됩니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Saved. Applies from your next lookup." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存しました。次の検索から適用されます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已保存，将从下次查询开始生效。" } }
      }
    },
    "로컬 모델" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Local Model" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ローカルモデル" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地模型" } }
      }
    },
    "기본 제공 모델은 선택하면 바로 저장됩니다. 처음 사용하는 모델은 조회할 때 Hugging Face에서 내려받으므로 네트워크 연결과 수 GB의 여유 공간이 필요할 수 있어요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Built-in models save as soon as you pick one. A first-time model downloads from Hugging Face on lookup, so a network connection and several GB of free space may be needed." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "内蔵モデルは選ぶとすぐ保存されます。初めて使うモデルは検索時にHugging Faceからダウンロードするため、ネットワーク接続と数GBの空き容量が必要になることがあります。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内置模型选中即保存。首次使用的模型会在查询时从 Hugging Face 下载，可能需要网络连接和数 GB 可用空间。" } }
      }
    },
    "현재 사용 중인 모델" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Current Model" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のモデル" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前使用的模型" } }
      }
    },
    "공개 웹 자료 검색" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Search Public Web Sources" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "公開ウェブ資料を検索" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "搜索公开网页资料" } }
      }
    },
    "새 개념을 조회할 때 DuckDuckGo 검색과 공개 웹페이지를 참고합니다. 실제로 읽은 자료만 출처로 저장해요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "New lookups consult DuckDuckGo search and public web pages. Only material actually read is stored as a source." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しい概念の検索時にはDuckDuckGo検索と公開ウェブページを参照します。実際に読んだ資料だけを出典として保存します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查询新概念时会参考 DuckDuckGo 搜索和公开网页。只有实际读过的资料才会存为出处。" } }
      }
    },
    "로컬 모델의 지식으로 설명을 만듭니다. 결과에는 외부 출처가 없는 AI 초안임을 표시해요." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Writes explanations from the local model's knowledge. Results are marked as AI drafts without external sources." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ローカルモデルの知識で説明を作成します。結果には外部出典のないAI下書きであることが表示されます。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用本地模型的知识生成解释。结果会标注为无外部出处的 AI 草稿。" } }
      }
    },
    "변경은 다음 조회부터 바로 적용됩니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Changes apply from your next lookup." } },
